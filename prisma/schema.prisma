generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum PortfolioContentType {
  STACK
  CERTIFICATION
  RECOMMENDATION
  SKILL
}

model User {
  id        String   @id @default(cuid())
  pinHash   String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  excerpt   String
  content   String
  slug      String   @unique
  category  String
  imageUrl  String?
  link      String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  category        String    @default("web")
  role            String
  description     String
  fullDescription String?
  stack           String[]
  highlights      String[]
  contributions   Json?
  coverImageUrl   String?
  images          String[]  @default([])
  status          String    @default("completed")
  sourceUrl       String?
  liveUrl         String?
  featured        Boolean   @default(false)
  published       Boolean   @default(true)
  sortOrder       Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category, published, deletedAt, sortOrder])
}

model Experience {
  id          String    @id @default(cuid())
  company     String
  role        String
  location    String
  startDate   String
  endDate     String?
  description String
  highlights  String[]
  published   Boolean   @default(false)
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PortfolioContent {
  id          String               @id @default(cuid())
  kind        PortfolioContentType
  title       String
  subtitle    String?
  description String?
  category    String?
  url         String?
  published   Boolean              @default(false)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([kind, published, sortOrder])
}

model SiteSettings {
  id             String         @id @default("site")
  isHired        Boolean        @default(false)
  activeResumeId String?        @unique
  activeResume   ResumeVersion? @relation("ActiveResume", fields: [activeResumeId], references: [id], onDelete: SetNull)
  updatedAt      DateTime       @updatedAt
}

model ResumeVersion {
  id            String        @id @default(cuid())
  fileName      String
  objectKey     String        @unique
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime      @default(now())
  activeForSite SiteSettings? @relation("ActiveResume")
}

model VisitorLog {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  visitedAt DateTime @default(now())

  @@index([visitedAt])
  @@index([visitorId, visitedAt])
}
