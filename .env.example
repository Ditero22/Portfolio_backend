# Server port for the Express API.
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Copy this file to `.env` and replace every placeholder with private values.
# PostgreSQL connection string (PostgreSQL >= 15).
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# Optional direct connection for migrations. The migration script automatically
# uses the direct Neon hostname when DATABASE_URL is a Neon pooler URL.
# The running API continues to use DATABASE_URL, including connection pooling.
DIRECT_URL=

# Required by admin login and protected routes. Use at least 32 random characters.
JWT_SECRET=replace-with-at-least-32-random-characters

# Used only by `npm run seed`; choose a private eight-digit PIN.
ADMIN_PIN=

# Google Identity Services Web client ID used to verify PIN recovery.
# Set this same public client ID as VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=
# Only this verified Google account may recover the admin PIN.
ADMIN_GOOGLE_EMAIL=admin@example.com

# Comma-separated frontend origins. Production requires exact HTTPS origins only.
CORS_ORIGINS=http://localhost:5173
# In development, localhost and this computer's LAN IPv4 origins on this port
# are included automatically. Production only uses the exact CORS_ORIGINS list.
DEV_FRONTEND_PORT=5173

# Number of trusted reverse proxies in front of Express.
# Local development can use 0. Render production should use 1 to trust its proxy
# and let per-IP rate limits use the forwarded client address; never use `true`.
TRUST_PROXY_HOPS=0

# The memory store is appropriate for one API process.
# Use Redis when running multiple API instances so every instance shares limits.
RATE_LIMIT_STORE=memory
REDIS_URL=
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_PIN_RESET_RATE_LIMIT_WINDOW_MS=900000
AUTH_PIN_RESET_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=12

# Cloudflare R2 blog image storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL or image Worker URL, without an object key. If using a Worker,
# it must serve blog/, projects/, and certifications/ from this same bucket.
# Do not expose private resumes/ files through the public image Worker.
R2_PUBLIC_URL=
