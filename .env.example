# Server port for the Express API.
PORT=5000

# Copy this file to `.env` and replace every placeholder with private values.
# PostgreSQL connection string (PostgreSQL >= 15).
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Required by admin login and protected routes. Use a unique random secret.
JWT_SECRET=replace-with-a-long-random-secret

# Used only by `npm run seed`; choose a private eight-digit PIN.
ADMIN_PIN=

# Google Identity Services Web client ID used to verify PIN recovery.
# Set this same public client ID as VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=
# Only this verified Google account may recover the admin PIN.
ADMIN_GOOGLE_EMAIL=karl.ortega.2002.ko@gmail.com

# Comma-separated frontend origins. Replace with your deployed HTTPS site origin.
CORS_ORIGINS=http://localhost:5173

# Number of trusted reverse proxies in front of Express.
# Keep 0 when the API is reached directly; never set this to `true`.
TRUST_PROXY_HOPS=0

# The memory store is appropriate for one API process.
# Use Redis when running multiple API instances so every instance shares limits.
RATE_LIMIT_STORE=memory
REDIS_URL=
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_PIN_RESET_RATE_LIMIT_WINDOW_MS=900000
AUTH_PIN_RESET_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=12

# Cloudflare R2 blog image storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
